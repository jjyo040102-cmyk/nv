ACTFLOW_DATA_DIR=./data/runtime
ACTFLOW_DB_PATH=./data/runtime/actflow.sqlite
ACTFLOW_DEMO_AUTH=true
ACTFLOW_MAX_UPLOAD_MB=25
# 32 random bytes encoded as 64 hex characters; optional for persistent encrypted credentials.
ACTFLOW_MASTER_KEY=
# Launcher generates and persists this separately from ACTFLOW_MASTER_KEY.
ACTFLOW_SESSION_SECRET=
# CLI real-inference benchmark only; the browser uses session-scoped encrypted Nebius credentials.
NEBIUS_API_KEY=
# Real Gmail requires OAuth configuration and explicit sending opt-in.
ACTFLOW_REAL_MAIL_ENABLED=false
ACTFLOW_PUBLIC_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ACTFLOW_WORKER_ENABLED=true
